{
  "name": "dashboard-agent-obsidian",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard do fluxo de cards do Agent Obsidian",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "test": "node esbuild.test.mjs && node test/.build/run.cjs",
    "smoke": "node test/smoke.cjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run smoke",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "esbuild": "^0.20.2",
    "js-yaml": "^4.3.2",
    "jsdom": "^24.1.3",
    "obsidian": "^1.5.7",
    "typescript": "^5.4.5"
  }
}
